+static void mt7615_cancel_phy_work(struct mt7615_phy *phy)
+{
+	if (!phy)
+		return;
+	cancel_delayed_work_sync(&phy->mt76->mac_work);
+	cancel_delayed_work_sync(&phy->scan_work);
+	timer_shutdown_sync(&phy->roc_timer);
+	cancel_work_sync(&phy->roc_work);
+	if (test_bit(MT76_STATE_REGISTERED, &phy->mt76->state))
+		cancel_delayed_work_sync(&phy->mt76->roc_work);
+	skb_queue_purge(&phy->scan_event_list);
+}
+
+static void mt7615_stop_data_tx(struct mt7615_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	int i, j;
+
+	/* Keep MCU_RESET clear until the exit command has completed. */
+	for (i = 0; i < ARRAY_SIZE(mdev->phys); i++) {
+		struct mt76_phy *phy = mdev->phys[i];
+
+		if (!phy)
+			continue;
+		set_bit(MT76_RESET, &phy->state);
+		if (test_bit(MT76_STATE_REGISTERED, &phy->state))
+			ieee80211_stop_queues(phy->hw);
+	}
+	mt76_worker_disable(&mdev->tx_worker);
+	/* Drain submissions already past their state check, including PS
+	 * delivery outside the TX worker. Later data queue entries see RESET.
+	 */
+	for (i = 0; i < ARRAY_SIZE(mdev->phys); i++) {
+		struct mt76_phy *phy = mdev->phys[i];
+
+		if (!phy)
+			continue;
+		for (j = 0; j < ARRAY_SIZE(phy->q_tx); j++) {
+			struct mt76_queue *q = phy->q_tx[j];
+
+			if (!q)
+				continue;
+			spin_lock_bh(&q->lock);
+			spin_unlock_bh(&q->lock);
+		}
+	}
+}
