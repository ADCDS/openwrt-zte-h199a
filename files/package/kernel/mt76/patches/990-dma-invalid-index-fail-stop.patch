+/* Never registered: neither PCI unbind nor wiphy_unregister may release
+ * these resources. If hardware cannot be stopped, retain them until reboot.
+ * The registry also prevents repeated probes from accumulating quarantines.
+ */
+struct mt76_dma_owner {
+	struct device resources;
+	struct device *dma_dev;
+	struct list_head list;
+	char *identity;
+};
+
+static LIST_HEAD(mt76_dma_owners);
+static DEFINE_MUTEX(mt76_dma_owners_lock);
+
+bool mt76_dma_device_busy(struct device *dev)
+{
+	struct mt76_dma_owner *entry;
+	char *identity;
+	bool busy = false;
+
+	identity = kasprintf(GFP_KERNEL, "%s:%s",
+		dev->bus ? dev->bus->name : "platform", dev_name(dev));
+	if (!identity)
+		return true;
+	mutex_lock(&mt76_dma_owners_lock);
+	list_for_each_entry(entry, &mt76_dma_owners, list) {
+		if (!strcmp(entry->identity, identity)) {
+			busy = true;
+			break;
+		}
+	}
+	mutex_unlock(&mt76_dma_owners_lock);
+	kfree(identity);
+	return busy;
+}
+EXPORT_SYMBOL_GPL(mt76_dma_device_busy);
+
+static void mt76_dma_owner_release(struct device *resources)
+{
+	struct mt76_dma_owner *owner = container_of(resources,
+					struct mt76_dma_owner, resources);
+
+	mutex_lock(&mt76_dma_owners_lock);
+	list_del(&owner->list);
+	mutex_unlock(&mt76_dma_owners_lock);
+	put_device(owner->dma_dev);
+	kfree(owner->identity);
+	kfree(owner);
+	module_put(THIS_MODULE);
+}
+
+int mt76_dma_owner_init(struct mt76_dev *dev)
+{
+	struct mt76_dma_owner *owner, *entry;
+	int ret = 0;
+
+	owner = kzalloc(sizeof(*owner), GFP_KERNEL);
+	if (!owner)
+		return -ENOMEM;
+	owner->identity = kasprintf(GFP_KERNEL, "%s:%s",
+		dev->dev->bus ? dev->dev->bus->name : "platform",
+		dev_name(dev->dev));
+	if (!owner->identity) {
+		kfree(owner);
+		return -ENOMEM;
+	}
+	mutex_lock(&mt76_dma_owners_lock);
+	list_for_each_entry(entry, &mt76_dma_owners, list) {
+		if (!strcmp(entry->identity, owner->identity)) {
+			ret = -EBUSY;
+			goto failed;
+		}
+	}
+	if (!try_module_get(THIS_MODULE)) {
+		ret = -ENODEV;
+		goto failed;
+	}
+	device_initialize(&owner->resources);
+	owner->resources.release = mt76_dma_owner_release;
+	owner->dma_dev = get_device(dev->dma_dev);
+	list_add(&owner->list, &mt76_dma_owners);
+	dev->dma_resources = &owner->resources;
+	mutex_unlock(&mt76_dma_owners_lock);
+	return 0;
+failed:
+	mutex_unlock(&mt76_dma_owners_lock);
+	kfree(owner->identity);
+	kfree(owner);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt76_dma_owner_init);
+
+void mt76_dma_owner_put(struct mt76_dev *dev)
+{
+	if (dev->dma_resources && !dev->dma_quarantined) {
+		put_device(dev->dma_resources);
+		dev->dma_resources = NULL;
+	}
+}
+EXPORT_SYMBOL_GPL(mt76_dma_owner_put);
+
+struct mt76_dma_allocation {
+	struct device *dma_dev;
+	void *address;
+	dma_addr_t dma;
+	size_t bytes;
+};
+
+static void mt76_dma_free_allocation(void *data)
+{
+	struct mt76_dma_allocation *allocation = data;
+
+	dma_free_coherent(allocation->dma_dev, allocation->bytes,
+			  allocation->address, allocation->dma);
+	kfree(allocation);
+}
+
+static void *mt76_dma_alloc_desc(struct mt76_dev *dev, size_t bytes,
+				dma_addr_t *dma)
+{
+	struct mt76_dma_allocation *allocation;
+
+	if (!dev->dma_resources)
+		return dmam_alloc_coherent(dev->dma_dev, bytes, dma, GFP_KERNEL);
+	allocation = kzalloc(sizeof(*allocation), GFP_KERNEL);
+	if (!allocation)
+		return NULL;
+	allocation->address = dma_alloc_coherent(dev->dma_dev, bytes, dma, GFP_KERNEL);
+	if (!allocation->address) {
+		kfree(allocation);
+		return NULL;
+	}
+	allocation->dma_dev = dev->dma_dev;
+	allocation->bytes = bytes;
+	allocation->dma = *dma;
+	if (devm_add_action_or_reset(dev->dma_resources,
+				     mt76_dma_free_allocation, allocation))
+		return NULL;
+	return allocation->address;
+}
+
+static void mt76_dma_destroy_pool(void *pool)
+{
+	page_pool_destroy(pool);
+}
 
