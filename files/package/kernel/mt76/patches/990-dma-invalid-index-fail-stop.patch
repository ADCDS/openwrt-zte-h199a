+static bool mt76_dma_queue_cleanup_valid(struct mt76_queue *q)
+{
+	if (!q)
+		return true;
+	if (!q->entry)
+		return !q->queued;
+	return q->ndesc > 0 && q->head < q->ndesc &&
+	       q->tail < q->ndesc && q->queued >= 0 && q->queued <= q->ndesc;
+}
+
+static bool mt76_dma_cleanup_valid(struct mt76_dev *dev)
+{
+	int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(dev->phys); i++) {
+		if (!dev->phys[i])
+			continue;
+		for (j = 0; j < ARRAY_SIZE(dev->phys[i]->q_tx); j++)
+			if (!mt76_dma_queue_cleanup_valid(dev->phys[i]->q_tx[j]))
+				return false;
+	}
+	for (i = 0; i < ARRAY_SIZE(dev->q_mcu); i++)
+		if (!mt76_dma_queue_cleanup_valid(dev->q_mcu[i]))
+			return false;
+	for (i = 0; i < ARRAY_SIZE(dev->q_rx); i++)
+		if (!mt76_dma_queue_cleanup_valid(&dev->q_rx[i]))
+			return false;
+	return true;
+}
