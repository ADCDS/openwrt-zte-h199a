+void mt76_dma_stop_napi(struct mt76_dev *dev)
+{
+	int i;
+
+	if (dev->dma_napi_stopped)
+		return;
+	mt76_worker_disable(&dev->tx_worker);
+	if (dev->tx_napi.dev) {
+		if (!dev->dma_napi_disabled)
+			napi_disable(&dev->tx_napi);
+		netif_napi_del(&dev->tx_napi);
+	}
+	for (i = 0; i < ARRAY_SIZE(dev->napi); i++) {
+		if (!dev->napi[i].dev)
+			continue;
+		if (!dev->dma_napi_disabled)
+			napi_disable(&dev->napi[i]);
+		netif_napi_del(&dev->napi[i]);
+	}
+	dev->dma_napi_stopped = true;
+	dev->dma_napi_disabled = true;
+}
+EXPORT_SYMBOL_GPL(mt76_dma_stop_napi);
+
+void mt76_dma_quarantine(struct mt76_dev *dev)
+{
+	mt76_dma_stop_napi(dev);
+	if (!dev->dma_quarantined)
+		dev_err(dev->dev, "DMA memory quarantined until reboot; reprobe denied\n");
+	dev->dma_quarantined = true;
+}
+EXPORT_SYMBOL_GPL(mt76_dma_quarantine);
