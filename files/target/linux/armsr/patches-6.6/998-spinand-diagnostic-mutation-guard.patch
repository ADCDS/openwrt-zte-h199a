--- a/drivers/mtd/nand/spi/Kconfig
+++ b/drivers/mtd/nand/spi/Kconfig
@@ -7,3 +7,14 @@
 	select SPI_MEM
 	help
 	  This is the framework for the SPI NAND device drivers.
+
+config MTD_SPI_NAND_DIAGNOSTIC
+	bool "SPI NAND mutation failure guard for qualification"
+	depends on MTD_SPI_NAND=y
+	default n
+	help
+	  Permit the boot-only diagnostic_write_guard option. It forbids bad
+	  block marking and stops later mutations after the first write/erase
+	  failure. Built-in support and suppressed bind attributes keep the
+	  failure latch alive until reboot. Normal operation is unchanged when
+	  the option is not selected at boot. Say N in production builds.
