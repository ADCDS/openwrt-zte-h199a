# Serialise squashfs decompression. With CONFIG_SMP=y the kernel otherwise
# selects DECOMP_MULTI_PERCPU, which issues concurrent reads into the spifc
# NAND driver and reproduces the read errors documented in docs/BRINGUP.md
# (init dies with "Error loading shared library ...: I/O error").
CONFIG_SQUASHFS_COMPILE_DECOMP_SINGLE=y
# CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI is not set
# CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU is not set
CONFIG_SQUASHFS_DECOMP_SINGLE=y
# CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU is not set

# Trim subsystems this board does not have. The validated hand-tuned kernel had
# these off and logged zero SQUASHFS read errors; the untrimmed recipe kernel
# logs ~27 (non-fatal). Fewer subsystems probing concurrently with NAND reads
# also keeps the kernel inside the 3 MiB flash partition.
# (PCI is deliberately left enabled - the Wi-Fi part sits behind a PCIe root
# complex, see docs/WIFI.md.)
# CONFIG_USB_SUPPORT is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_INPUT is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_BROADCOM is not set
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_NET_VENDOR_MARVELL is not set
# CONFIG_NET_VENDOR_MICROCHIP is not set
# CONFIG_NET_VENDOR_STMICRO is not set
# CONFIG_NET_VENDOR_AMAZON is not set
# CONFIG_NET_VENDOR_AQUANTIA is not set

# Do not split a second "rootfs_data" out of the tail of the rootfs partition.
# That partition is covered by the vendor image CRC which the bootloader checks
# every boot, so an overlay written there makes the board fall back to the stock
# bank. The overlay is a dedicated partition at 0x4000000 instead - see the DTS.
# CONFIG_MTD_SPLIT_SQUASHFS_ROOT is not set
