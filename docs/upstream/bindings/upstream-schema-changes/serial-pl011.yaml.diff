--- a/Documentation/devicetree/bindings/serial/pl011.yaml
+++ b/Documentation/devicetree/bindings/serial/pl011.yaml
@@ -12,6 +12,16 @@
 allOf:
   - $ref: /schemas/arm/primecell.yaml#
   - $ref: serial.yaml#
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: zte,zx279128s-uart
+    then:
+      # TODO: drop this requirement if the driver is changed to select the
+      # ZTE register map from the compatible instead of the invented AMBA ID.
+      required:
+        - arm,primecell-periphid
 
 # Need a custom select here or 'arm,primecell' will match on lots of nodes
 select:
@@ -25,9 +35,20 @@
 
 properties:
   compatible:
-    items:
-      - const: arm,pl011
-      - const: arm,primecell
+    oneOf:
+      - items:
+          - const: arm,pl011
+          - const: arm,primecell
+      - description:
+          ZTE ZX279128S UART. PL011 programming model with a relocated
+          register map (DR at 0x04, FR at 0x14, IBRD/FBRD at the standard
+          0x24/0x28) and no AMBA peripheral ID registers, so the node must
+          also carry arm,primecell-periphid = <0x001feffe> for the AMBA bus
+          to bind the ZTE register layout.
+        items:
+          - const: zte,zx279128s-uart
+          - const: arm,pl011
+          - const: arm,primecell
 
   reg:
     maxItems: 1
