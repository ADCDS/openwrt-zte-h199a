# Seed config for the ZTE H199A port (OpenWrt 24.10, armsr/armv7).
# Kernel/DTS: custom (files/ overlay adds arch/arm/boot/dts/zte/zx279128s-zte-h199a.dts).
# CPU tuning: cortex-a9 (target.mk override — upstream armsr tunes cortex-a15,
# which emits VFPv4 code the ZX279128S A9 cannot execute).
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv7=y
# The flashed image is squashfs, not initramfs. Keeping INITRAMFS=y here made
# the build emit only an initramfs kernel, so the kernel actually flashed had to
# be produced by hand-editing build_dir/.config - which is how the round-115
# kernel/header mismatch happened. The initramfs kernel is still useful as a
# TFTP rescue image; build it deliberately, not by default.
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_MULTI_PROFILE=n

# Wi-Fi: MediaTek MT7613BE (14c3:7663) behind the ZX279128S DesignWare PCIe root
# complex. MT7613BE is driven by mainline mt7615e (there is no mt7613 driver),
# with firmware mt7663pr2h.bin. See docs/WIFI.md rounds 100-108.
CONFIG_PACKAGE_kmod-mt7615e=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y
# MT7613BE reports PCI ID 14c3:7663 and needs the MT7663 AP firmware, which is a
# separate package from kmod-mt7615-firmware (that one only ships mt7615_*.bin).
CONFIG_PACKAGE_kmod-mt7663-firmware-ap=y
CONFIG_PACKAGE_kmod-mt76-core=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_flock=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_iw=y

# Build the H199A device profile (target/linux/armsr/image/Makefile)
CONFIG_TARGET_armsr_armv7_DEVICE_zte_h199a=y

# BusyBox TFTP remains useful for recovery alongside the working TCP path.
# NOTE: per-applet busybox symbols are IGNORED unless BUSYBOX_CUSTOM is set -
# package/utils/busybox/Config.in wraps them all in `if BUSYBOX_CUSTOM`. Without
# it the package regenerates its .config from defaults on every build, which is
# why enabling TFTP appeared to work in openwrt/.config and in a hand-edited
# build_dir config, yet the device still reported `tftp: applet not found`.
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_TFTP=y
CONFIG_BUSYBOX_CONFIG_FEATURE_TFTP_GET=y
CONFIG_BUSYBOX_CONFIG_FEATURE_TFTP_PUT=y
# Block-size negotiation (RFC 2348). Without it TFTP uses 512-byte blocks in
# lock-step - one ACK per block - so a 17 MB image is ~34,000 round trips and
# busybox's own timeout fires before it finishes. With 1400-byte blocks it is
# ~12,000, which fits.
CONFIG_BUSYBOX_CONFIG_FEATURE_TFTP_BLOCKSIZE=y

# LuCI with its default uhttpd server. Normal userspace still needs final-image
# validation on wired and wireless interfaces.
CONFIG_PACKAGE_luci=y

# 2.4 GHz radio: MT7603E behind PCIe port 1, with owner-provided base calibration.
CONFIG_PACKAGE_kmod-mt7603=y

# Throughput and soak testing; current measured limits are in docs/ETHERNET.md.
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_h199a-upgrade=y
# Qualification uses the filesystem's uncompressed default.
# CONFIG_FSTOOLS_OVL_MOUNT_COMPRESS_ZLIB is not set

# Reset and WPS buttons. The stock kernel's own button table gives RESET on
# GPIO 39 and WPS on GPIO 41, both active low (GetKeyGPIO returns the inverse of
# the pin level). OpenWrt's button-hotplug is the idiomatic consumer for
# gpio-keys on this platform - it turns the presses into hotplug events rather
# than needing an input stack in the image.
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
