+/* Private one-shot control, before either PCI host or DMA user exists. */
+static int zx_pcie_retry_after_clocks(struct zx_pcie *pair)
+{
+	u32 value;
+	int i, ret = 0, error;
+
+	/* Stop and verify BOTH LTSSMs before any new falling reset edge. */
+	for (i = 0; i < 2; i++) {
+		value = readl(pair[i].glue + ZX_GLUE_CTRL);
+		writel(value & ~ZX_GLUE_LTSSM_EN, pair[i].glue + ZX_GLUE_CTRL);
+		if ((readl(pair[i].glue + ZX_GLUE_CTRL) & ZX_GLUE_LTSSM_EN) && !ret)
+			ret = -EIO;
+	}
+	if (ret)
+		goto release_both;
+	for (i = 0; i < 2; i++) {
+		ret = zx_perst_set(&pair[i], true);
+		if (ret)
+			goto release_both;
+	}
+	mdelay(100);
+release_both:
+	/* Never short-circuit cleanup, even if an assertion or release failed. */
+	for (i = 0; i < 2; i++) {
+		error = zx_perst_set(&pair[i], false);
+		if (error && !ret)
+			ret = error;
+	}
+	if (ret)
+		return ret;
+	mdelay(200);
+	for (i = 0; i < 2; i++)
+		zx_pcie_train(&pair[i]);
+	return 0;
+}
