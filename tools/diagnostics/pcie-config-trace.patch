 #define to_zx_pcie(x)	dev_get_drvdata((x)->dev)
+
+static bool zx_trace_offset(u32 reg, size_t size)
+{
+	u32 end;
+
+	if ((size != 1 && size != 2 && size != 4) || reg > 0x1000 - size)
+		return false;
+	end = reg + size;
+	return reg < 0x100 || (reg < 0x84 && end > 0x80) ||
+	       (reg < 0xa4 && end > 0xa0) ||
+	       (reg < 0x108 && end > 0x104) ||
+	       (reg < 0x114 && end > 0x110) ||
+	       (reg < 0x134 && end > 0x130);
+}
+
+/* No MMIO, allocation, printk or PCI lock acquisition in this logger. */
+static void zx_record_write(struct zx_pcie *zx, u8 route, unsigned int devfn,
+			    u32 reg, size_t size, u32 value, unsigned long caller)
+{
+	struct zx_cfg_write *entry;
+	unsigned long flags;
+	u64 seq;
+
+	if (!zx->trace_writes || route > 1 || !zx_trace_offset(reg, size))
+		return;
+	raw_spin_lock_irqsave(&zx->trace_lock, flags);
+	seq = ++zx->trace_total;
+	zx->trace_route_count[route]++;
+	entry = &zx->trace_ring[(seq - 1) & (ZX_TRACE_ENTRIES - 1)];
+	*entry = (struct zx_cfg_write) {
+		.seq = seq, .stamp = ktime_get_ns(), .caller = caller,
+		.reg = reg, .value = value, .pid = task_pid_nr(current),
+		.devfn = devfn, .cpu = raw_smp_processor_id(),
+		.size = size, .route = route,
+	};
+	raw_spin_unlock_irqrestore(&zx->trace_lock, flags);
+}
+
+static void zx_trace_write_dbi(struct dw_pcie *pci, void __iomem *base,
+			       u32 reg, size_t size, u32 value)
+{
+	struct zx_pcie *zx = container_of(pci, struct zx_pcie, pci);
+	int ret;
+
+	/* This hook also services iATU; never mistake another base for DBI. */
+	if (base == pci->dbi_base)
+		zx_record_write(zx, 0, 0, reg, size, value, _RET_IP_);
+	ret = dw_pcie_write(base + reg, size, value);
+	if (ret)
+		dev_err(pci->dev, "Write DBI address failed\n");
+}
+
+static int zx_trace_root_write(struct pci_bus *bus, unsigned int devfn,
+			       int where, int size, u32 value)
+{
+	struct dw_pcie_rp *pp = bus->sysdata;
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct zx_pcie *zx = container_of(pci, struct zx_pcie, pci);
+
+	if (pci_is_root_bus(bus) && !PCI_SLOT(devfn))
+		zx_record_write(zx, 1, devfn, where, size, value, _RET_IP_);
+	/* The PCI caller already holds pci_lock. Delegate without recursion. */
+	return zx->original_root_ops->write(bus, devfn, where, size, value);
+}
+
+static ssize_t cpu_config_writes_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	struct zx_pcie *zx = dev_get_drvdata(dev);
+	struct zx_cfg_write *entries;
+	unsigned long flags;
+	u64 total, dbi, pci;
+	unsigned int count, i;
+	int at;
+
+	entries = kmalloc_array(ZX_TRACE_ENTRIES, sizeof(*entries), GFP_KERNEL);
+	if (!entries)
+		return -ENOMEM;
+	raw_spin_lock_irqsave(&zx->trace_lock, flags);
+	total = zx->trace_total;
+	dbi = zx->trace_route_count[0];
+	pci = zx->trace_route_count[1];
+	count = min_t(u64, total, ZX_TRACE_ENTRIES);
+	for (i = 0; i < count; i++)
+		entries[i] = zx->trace_ring[(total - 1 - i) & (ZX_TRACE_ENTRIES - 1)];
+	raw_spin_unlock_irqrestore(&zx->trace_lock, flags);
+	at = sysfs_emit(buf, "enabled=%u total=%llu dbi=%llu pci=%llu entries=%u newest-first intent-only\n",
+			zx->trace_writes, (unsigned long long)total,
+			(unsigned long long)dbi, (unsigned long long)pci, count);
+	for (i = 0; i < count && at < PAGE_SIZE - 192; i++) {
+		struct zx_cfg_write *e = &entries[i];
+
+		at += sysfs_emit_at(buf, at,
+			"seq=%llu ns=%llu route=%s cpu=%u pid=%u devfn=%02x reg=%03x size=%u val=%08x caller=%pS\n",
+			(unsigned long long)e->seq, (unsigned long long)e->stamp,
+			e->route ? "pci" : "dbi", e->cpu, e->pid, e->devfn,
+			e->reg, e->size, e->value, (void *)e->caller);
+	}
+	kfree(entries);
+	return at;
+}
+static DEVICE_ATTR_RO(cpu_config_writes);
+
+/* Private read-only comparison with the decoded VID6 board table. */
+static ssize_t board_controls_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	struct zx_pcie *zx = dev_get_drvdata(dev);
+	u32 direction, levels;
+	unsigned int i;
+	int at;
+
+	if (!zx->trace_writes)
+		return sysfs_emit(buf, "disabled\n");
+	at = sysfs_emit(buf, "read-only VID6 controls port=%u\n", zx->port);
+	for (i = 0; i < 6; i++)
+		at += sysfs_emit_at(buf, at, "crm2_%02x=%08x\n", i * 4,
+				    readl(zx->crm2 + i * 4));
+	if (zx->trace_gpio) {
+		direction = readl(zx->trace_gpio + ZX_GPIO_BANK(52));
+		levels = readl(zx->trace_gpio + ZX_GPIO_BANK(52) + ZX_GPIO_IN);
+		for (i = 52; i <= 55; i++)
+			at += sysfs_emit_at(buf, at, "gpio%u output=%u level=%u\n", i,
+				!!(direction & BIT(i & 15)), !!(levels & BIT(i & 15)));
+	}
+	return at;
+}
+static DEVICE_ATTR_RO(board_controls);
 
