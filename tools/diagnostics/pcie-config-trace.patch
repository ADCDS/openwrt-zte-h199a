+/* Private diagnostic only: CPU write intents, never a recovery action. */
+#define ZX_TRACE_ENTRIES 32
+struct zx_cfg_write {
+	u64 seq, stamp;
+	unsigned long caller;
+	u32 reg, value, pid, devfn;
+	u16 cpu;
+	u8 size, route;
+};
